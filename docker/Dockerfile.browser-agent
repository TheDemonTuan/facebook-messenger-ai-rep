FROM mcr.microsoft.com/playwright:v1.50.1-noble AS base
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    net-tools \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Bun 1.4
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v1.4.1"
ENV PATH="/root/.bun/bin:${PATH}"

COPY package.json bun.lock tsconfig.base.json tsconfig.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/queue/package.json ./packages/queue/
COPY packages/channel/package.json ./packages/channel/
COPY apps/browser-agent/package.json ./apps/browser-agent/

RUN bun install --frozen-lockfile

COPY packages/contracts/ ./packages/contracts/
COPY packages/config/ ./packages/config/
COPY packages/db/ ./packages/db/
COPY packages/queue/ ./packages/queue/
COPY packages/channel/ ./packages/channel/
COPY apps/browser-agent/ ./apps/browser-agent/

RUN bun run --filter='@messenger/*' build && cd apps/browser-agent && bun x playwright install chromium

COPY docker/entrypoint-browser.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NODE_ENV=production
ENV BROWSER_HEADLESS=false
ENV BROWSER_PROFILE_DIR=/app/browser_profile
ENV DISPLAY=:99

EXPOSE 6080

ENTRYPOINT ["/entrypoint.sh"]
