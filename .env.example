# ==============================================================================
# Single-Agent AI Facebook Messenger - Environment Configuration
# ==============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database & Redis Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=messenger_ai
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@postgres:5432/messenger_ai

REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379

# Application Secrets (Must be at least 32 characters)
SESSION_SECRET=generate_a_random_32_character_string_for_session_encryption!
INTERNAL_HMAC_SECRET=generate_a_random_32_character_string_for_internal_hmac!

# OmniRoute / OpenAI Gateway
OMNIROUTE_BASE_URL=http://127.0.0.1:8000/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
DEFAULT_AI_MODEL=gemini-3.7-flash-low

# Cloudflare Zero Trust & Tunnel Integration
# Keep this file as placeholders only. Put real values in /opt/facebook-messenger-ai-rep/.env on the VPS.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
CLOUDFLARE_ACCESS_TEAM_NAME=your-team-name
CLOUDFLARE_ACCESS_AUD=your_application_aud_tag_from_cloudflare_access

# Browser Automation & Multi-Account Partitioning
DEFAULT_CHANNEL_ACCOUNT_ID=personal-messenger
BROWSER_PROFILE_DIR=/app/browser_profile
BROWSER_HEADLESS=false
NOVNC_PORT=6080

# Admin User Initial Bootstrap
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMeImmediately123!@#
ADMIN_ENABLE_TOTP=true
